---
const projects = [
  {
    num: '01',
    company: 'ONENEX',
    name: 'Yoma Connect',
    desc: "Myanmar's leading HR platform. Built biometric auth APIs, payroll, leave & attendance modules for 8,000+ daily employees.",
    stack: ['Laravel', 'GraphQL', 'NuxtJS'],
    year: '2023 — 2024',
  },
  {
    num: '02',
    company: 'HOST MYANMAR',
    name: 'HMM POS SaaS',
    desc: 'Multi-merchant Point-of-Sale — two-click checkout, barcode scanning, hold-and-resume, automated invoicing, and P&L analytics.',
    stack: ['Laravel', 'Vue.js', 'MySQL'],
    year: '2022 — 2023',
  },
  {
    num: '03',
    company: 'LEAP TECH',
    name: 'LMS Architecture',
    desc: 'Learning Management System built with Domain-Driven Design. H5P interactive content, multi-role access, full test coverage.',
    stack: ['DDD', 'TDD', 'Laravel'],
    year: '2024 — Present',
  },
  {
    num: '04',
    company: 'LEAP TECH',
    name: 'Design Den',
    desc: 'Document management for interior designers — quotation generation, variation orders, customer e-signature portal, audit logging.',
    stack: ['Laravel', 'Vue.js', 'REST API'],
    year: '2024',
  },
  {
    num: '05',
    company: 'FREELANCE',
    name: 'AI-Augmented Delivery',
    desc: 'End-to-end freelance projects using Claude Code, Cursor, and GitHub Copilot. CI/CD pipelines, server provisioning, monitoring.',
    stack: ['Claude Code', 'Cursor', 'CI/CD'],
    year: '2024 — Present',
  },
];
---
<section id="work" class="section">
  <div class="section-inner">
    <div class="section-header">
      <h2 class="section-heading">Archive.</h2>
      <span class="section-tag">Selected Production Work</span>
    </div>

    <div>
      {projects.map((p) => (
        <div class="project-row reveal">
          <div class="project-company">{p.num} / {p.company}</div>
          <div>
            <h3 class="project-name">{p.name}</h3>
            <p class="project-desc">{p.desc}</p>
          </div>
          <div class="project-stack">
            {p.stack.map((s, i) => (
              <span>{s}{i < p.stack.length - 1 ? ' •' : ''}</span>
            ))}
          </div>
          <div class="project-year">{p.year}</div>
        </div>
      ))}
    </div>
  </div>
</section>
