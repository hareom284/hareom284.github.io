---
interface Props {
  title?: string;
}
const { title = 'Hare Om — Software Engineer · AI Builder · Bangkok' } = Astro.props;
const description = 'Hare Om — Software Engineer with 4+ years building production systems across web, mobile, and AI. Laravel, Vue.js, React, GraphQL. Available for jobs and freelance.';
const siteUrl = 'https://hareom284.com';
const ogImage = `${siteUrl}/og-image.png`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Hare Om, Zaw Zaw Win, Software Engineer, Bangkok, Laravel, Vue.js, React, GraphQL, AI developer, freelance developer" />
  <meta name="author" content="Hare Om" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={siteUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#030712" />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Hare Om",
    "alternateName": ["Zaw Zaw Win", "hareom284"],
    "url": siteUrl,
    "image": ogImage,
    "jobTitle": "Software Engineer",
    "description": description,
    "knowsAbout": ["Laravel", "Vue.js", "React", "GraphQL", "TypeScript", "PHP", "AI", "DDD"],
    "address": { "@type": "PostalAddress", "addressLocality": "Bangkok", "addressCountry": "TH" },
    "sameAs": [
      "https://www.linkedin.com/in/hareom284/",
      "https://github.com/hareom284",
      "https://www.upwork.com/freelancers/~0142b35bde73ee6ef7"
    ]
  })} />

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZMSD9B4J4D"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-ZMSD9B4J4D');
  </script>
</head>
<body class="grain">
  <!-- Ambient Background -->
  <div class="ambient-bg">
    <div class="ambient-orb ambient-orb-1"></div>
    <div class="ambient-orb ambient-orb-2"></div>
    <div class="ambient-orb ambient-orb-3"></div>
  </div>
  <div class="grid-overlay"></div>

  <!-- Custom Cursor -->
  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>

  <slot />

  <!-- Scroll Reveal -->
  <script is:inline>
    (function() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

      // Observe all .reveal elements, including those already in viewport
      document.querySelectorAll('.reveal').forEach(function(el) {
        observer.observe(el);
      });
    })();
  </script>

  <!-- Custom Cursor -->
  <script is:inline>
    (function() {
      var dot = document.getElementById('cursor-dot');
      var ring = document.getElementById('cursor-ring');
      var mx = 0, my = 0, rx = 0, ry = 0;

      // Hide custom cursor on touch devices
      if ('ontouchstart' in window) {
        dot.style.display = 'none';
        ring.style.display = 'none';
        return;
      }

      document.addEventListener('mousemove', function(e) {
        mx = e.clientX;
        my = e.clientY;
        dot.style.left = mx + 'px';
        dot.style.top = my + 'px';
      });

      function follow() {
        rx += (mx - rx) * 0.15;
        ry += (my - ry) * 0.15;
        ring.style.left = rx + 'px';
        ring.style.top = ry + 'px';
        requestAnimationFrame(follow);
      }
      follow();

      // Grow ring on hoverable elements
      var hoverEls = document.querySelectorAll('a, button, .project-row, .hero-tag');
      hoverEls.forEach(function(el) {
        el.addEventListener('mouseenter', function() {
          ring.classList.add('cursor-hover');
          dot.classList.add('cursor-hover');
        });
        el.addEventListener('mouseleave', function() {
          ring.classList.remove('cursor-hover');
          dot.classList.remove('cursor-hover');
        });
      });
    })();
  </script>

  <!-- Ambient orb parallax on mouse -->
  <script is:inline>
    (function() {
      if ('ontouchstart' in window) return;
      var orbs = document.querySelectorAll('.ambient-orb');
      var ticking = false;
      document.addEventListener('mousemove', function(e) {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function() {
          var cx = (e.clientX / window.innerWidth - 0.5) * 2;
          var cy = (e.clientY / window.innerHeight - 0.5) * 2;
          orbs[0].style.transform = 'translate(' + (cx * 20) + 'px,' + (cy * 15) + 'px)';
          orbs[1].style.transform = 'translate(' + (cx * -15) + 'px,' + (cy * -20) + 'px)';
          orbs[2].style.transform = 'translate(' + (cx * 10) + 'px,' + (cy * -10) + 'px)';
          ticking = false;
        });
      });
    })();
  </script>

  <!-- Visitor Country -->
  <script is:inline>
    (function() {
      var badge = document.getElementById('visitor-location');
      if (!badge) return;
      fetch('https://ipapi.co/json/')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d && d.country_name) {
            var flag = d.country_code
              ? String.fromCodePoint(...[...d.country_code.toUpperCase()].map(c => 0x1F1E6 - 65 + c.charCodeAt(0)))
              : '';
            badge.textContent = flag + ' ' + d.city + ', ' + d.country_name;
            badge.style.opacity = '1';
          }
        })
        .catch(function() {});
    })();
  </script>

  <style is:global>
    @import '../styles/global.css';
  </style>
</body>
</html>
